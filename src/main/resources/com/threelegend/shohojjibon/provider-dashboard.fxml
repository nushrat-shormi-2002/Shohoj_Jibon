<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.threelegend.shohojjibon.controller.ProviderDashboardController"
            style="-fx-background-color: #f5f7fa;">
    
    <!-- Top Bar -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #10b981, #059669); -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Shohoj Jibon - Provider Dashboard" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label fx:id="welcomeLabel" text="Welcome!" style="-fx-text-fill: white; -fx-font-size: 16px;" HBox.hgrow="ALWAYS"/>
                <Button text="Logout" fx:id="logoutButton" onAction="#handleLogout" 
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Main Content with Tabs -->
    <center>
        <TabPane fx:id="mainTabPane" style="-fx-padding: 20;" tabClosingPolicy="UNAVAILABLE">
            
            <!-- Overview Tab -->
            <Tab text="📊 Overview">
                <VBox spacing="20" style="-fx-padding: 20;">
                    <!-- Stats Cards -->
                    <HBox spacing="20">
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                            <Label text="🚌 Total Buses" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                            <Label fx:id="totalBusesLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                        </VBox>
                        
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                            <Label text="📋 Total Bookings" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                            <Label fx:id="totalBookingsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                        </VBox>
                        
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                            <Label text="💰 Total Revenue" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                            <Label fx:id="totalRevenueLabel" text="৳0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                        </VBox>
                    </HBox>
                    
                    <!-- Service Authorities -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="Your Service Authorities" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        <Label fx:id="authoritiesLabel" text="Loading..." style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                    </VBox>
                    
                    <!-- Quick Actions -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="Quick Actions" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        <HBox spacing="15">
                            <Button text="➕ Add New Bus" onAction="#handleShowAddBusDialog" 
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            <Button text="🔄 Refresh Data" onAction="#handleRefreshData" 
                                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </Tab>
            
            <!-- Manage Buses Tab -->
            <Tab text="🚌 Manage Buses">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Your Bus Services" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;" HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Add Bus" onAction="#handleShowAddBusDialog" 
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                        <Button text="🔄 Refresh" onAction="#handleRefreshBuses" 
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                    </HBox>
                    
                    <TableView fx:id="busTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 6;">
                        <columns>
                            <TableColumn fx:id="busNameCol" text="Bus Name" prefWidth="150"/>
                            <TableColumn fx:id="busNumberCol" text="Bus Number" prefWidth="120"/>
                            <TableColumn fx:id="routeCol" text="Route" prefWidth="200"/>
                            <TableColumn fx:id="fareCol" text="Fare" prefWidth="100"/>
                            <TableColumn fx:id="seatsCol" text="Seats" prefWidth="80"/>
                            <TableColumn fx:id="scheduleCol" text="Schedule" prefWidth="100"/>
                            <TableColumn fx:id="busTypeCol" text="Type" prefWidth="120"/>
                            <TableColumn fx:id="statusCol" text="Status" prefWidth="80"/>
                            <TableColumn fx:id="actionsCol" text="Actions" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- Bookings Tab -->
            <Tab text="📋 Bookings">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Service Bookings" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;" HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Refresh" onAction="#handleRefreshBookings" 
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                    </HBox>
                    
                    <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 6;">
                        <columns>
                            <TableColumn fx:id="bookingRefCol" text="Ref #" prefWidth="120"/>
                            <TableColumn fx:id="serviceTypeCol" text="Service" prefWidth="100"/>
                            <TableColumn fx:id="bookingDateCol" text="Date" prefWidth="120"/>
                            <TableColumn fx:id="quantityCol" text="Qty" prefWidth="60"/>
                            <TableColumn fx:id="amountCol" text="Amount" prefWidth="100"/>
                            <TableColumn fx:id="bookingStatusCol" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="paymentStatusCol" text="Payment" prefWidth="100"/>
                            <TableColumn fx:id="bookingActionsCol" text="Actions" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
    
    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #10b981; -fx-padding: 10;">
            <Label text="© 2025 Shohoj Jibon - Developed by Three_Legend" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>
