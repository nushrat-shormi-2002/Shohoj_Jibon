<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.threelegend.shohojjibon.controller.UserDashboardController"
            style="-fx-background-color: #f5f7fa;">
    
    <!-- Top Bar -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Shohoj Jibon" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label fx:id="welcomeLabel" text="Welcome!" style="-fx-text-fill: white; -fx-font-size: 16px;" HBox.hgrow="ALWAYS"/>
                <Button text="My Bookings" onAction="#handleMyBookings" 
                        style="-fx-background-color: white; -fx-text-fill: #667eea; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Button text="Logout" onAction="#handleLogout" 
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Main Content with Tabs -->
    <center>
        <TabPane style="-fx-padding: 20;" tabClosingPolicy="UNAVAILABLE">
            
            <!-- Buses Tab -->
            <Tab text="🚌 Buses">
                <VBox spacing="20" style="-fx-padding: 20;">
                    <!-- Search Section -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="Search Bus Services" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="From" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                                <TextField fx:id="busFromField" promptText="e.g., Dhaka" 
                                           style="-fx-padding: 10; -fx-background-radius: 6; -fx-text-fill: #333; -fx-prompt-text-fill: #999;"/>
                            </VBox>
                            
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="To" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                                <TextField fx:id="busToField" promptText="e.g., Chittagong" 
                                           style="-fx-padding: 10; -fx-background-radius: 6; -fx-text-fill: #333; -fx-prompt-text-fill: #999;"/>
                            </VBox>
                            
                            <Button text="Search" onAction="#handleSearchBus" 
                                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 6; -fx-cursor: hand;">
                                <VBox.margin><Insets top="20"/></VBox.margin>
                            </Button>
                        </HBox>
                    </VBox>
                    
                    <!-- Results -->
                    <VBox VBox.vgrow="ALWAYS" spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="Available Buses" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <TableView fx:id="busTable" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </VBox>
            </Tab>
            
            <!-- Doctors Tab -->
            <Tab text="👨‍⚕️ Doctors">
                <VBox spacing="20" style="-fx-padding: 20;">
                    <!-- Search Section -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="Find a Doctor" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        
                        <GridPane hgap="15" vgap="10">
                            <TextField fx:id="doctorSearchField" promptText="Search by name..." GridPane.columnIndex="0" GridPane.rowIndex="0"
                                       style="-fx-padding: 10; -fx-background-radius: 6; -fx-text-fill: #333; -fx-prompt-text-fill: #999;"/>
                            
                            <ComboBox fx:id="specialtyCombo" promptText="Specialty" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                      style="-fx-padding: 10; -fx-background-radius: 6;"/>
                            
                            <TextField fx:id="doctorLocationField" promptText="Location" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                       style="-fx-padding: 10; -fx-background-radius: 6; -fx-text-fill: #333; -fx-prompt-text-fill: #999;"/>
                            
                            <ComboBox fx:id="doctorSortCombo" promptText="Sort By" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                      style="-fx-padding: 10; -fx-background-radius: 6;"/>
                            
                            <Button text="Search Doctors" onAction="#handleSearchDoctors" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.rowSpan="2"
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15 25; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        </GridPane>
                    </VBox>
                    
                    <!-- Results -->
                    <VBox VBox.vgrow="ALWAYS" spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="Available Doctors" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <TableView fx:id="doctorTable" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </VBox>
            </Tab>
            
            <!-- Diagnostic Tests Tab -->
            <Tab text="🔬 Diagnostic Tests">
                <VBox spacing="20" style="-fx-padding: 20;">
                    <!-- Search Section -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="Find Diagnostic Tests" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        
                        <GridPane hgap="15" vgap="10">
                            <TextField fx:id="testSearchField" promptText="Search by test name..." GridPane.columnIndex="0" GridPane.rowIndex="0"
                                       style="-fx-padding: 10; -fx-background-radius: 6; -fx-text-fill: #333; -fx-prompt-text-fill: #999;"/>
                            
                            <ComboBox fx:id="testCategoryCombo" promptText="Category" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                      style="-fx-padding: 10; -fx-background-radius: 6;"/>
                            
                            <TextField fx:id="testLocationField" promptText="Location" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                       style="-fx-padding: 10; -fx-background-radius: 6; -fx-text-fill: #333; -fx-prompt-text-fill: #999;"/>
                            
                            <ComboBox fx:id="testSortCombo" promptText="Sort By" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                      style="-fx-padding: 10; -fx-background-radius: 6;"/>
                            
                            <Button text="Search Tests" onAction="#handleSearchTests" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.rowSpan="2"
                                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15 25; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        </GridPane>
                    </VBox>
                    
                    <!-- Results -->
                    <VBox VBox.vgrow="ALWAYS" spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="Available Tests" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <TableView fx:id="testTable" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>
    
    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #667eea; -fx-padding: 10;">
            <Label text="© 2025 Shohoj Jibon - Developed by Three_Legend" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>

