<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.threelegend.shohojjibon.controller.UserDashboardController"
            style="-fx-background-color: #f5f7fa;">
    
    <!-- Top Bar -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Shohoj Jibon" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label fx:id="welcomeLabel" text="Welcome!" style="-fx-text-fill: white; -fx-font-size: 16px;" HBox.hgrow="ALWAYS"/>
                <Button text="My Bookings" onAction="#handleMyBookings" 
                        style="-fx-background-color: white; -fx-text-fill: #667eea; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Button text="Logout" onAction="#handleLogout" 
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Main Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <!-- Search Section -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label text="🚌 Search Bus Services" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="From" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                        <TextField fx:id="startPointField" promptText="e.g., Dhaka" 
                                   style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #ddd; -fx-border-radius: 6; -fx-text-fill: #333; -fx-prompt-text-fill: #999;"/>
                    </VBox>
                    
                    <Label text="→" style="-fx-font-size: 24px; -fx-text-fill: #667eea; -fx-padding: 20 0 0 0;"/>
                    
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="To" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                        <TextField fx:id="endPointField" promptText="e.g., Chittagong" 
                                   style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #ddd; -fx-border-radius: 6; -fx-text-fill: #333; -fx-prompt-text-fill: #999;"/>
                    </VBox>
                    
                    <Button fx:id="searchButton" text="Search" onAction="#handleSearchBus" 
                            style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 6; -fx-cursor: hand; -fx-pref-height: 40;">
                        <VBox.margin>
                            <Insets top="20"/>
                        </VBox.margin>
                    </Button>
                </HBox>
            </VBox>
            
            <!-- Results Section -->
            <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Available Buses" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" HBox.hgrow="ALWAYS"/>
                    <Button text="Book Selected" onAction="#handleBookBus" 
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
                
                <TableView fx:id="busTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 6;">
                    <columns>
                        <TableColumn fx:id="busNameCol" text="Bus Name" prefWidth="200"/>
                        <TableColumn fx:id="routeCol" text="Route" prefWidth="250"/>
                        <TableColumn fx:id="fareCol" text="Fare" prefWidth="120"/>
                        <TableColumn fx:id="timeCol" text="Departure" prefWidth="120"/>
                        <TableColumn fx:id="typeCol" text="Type" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
            
            <!-- Info Box -->
            <HBox spacing="15">
                <VBox spacing="5" HBox.hgrow="ALWAYS" style="-fx-background-color: #eff6ff; -fx-padding: 15; -fx-background-radius: 8;">
                    <Label text="ℹ️ Quick Info" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <Label text="More features coming soon: Hotels, Restaurants, Courses &amp; more!" style="-fx-font-size: 12px; -fx-text-fill: #3b82f6;" wrapText="true"/>
                </VBox>
                
                <VBox spacing="5" style="-fx-background-color: #f0fdf4; -fx-padding: 15; -fx-background-radius: 8;">
                    <Label text="📞 Support" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
                    <Label text="Contact: support@shohojjibon.com" style="-fx-font-size: 12px; -fx-text-fill: #16a34a;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
    
    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #667eea; -fx-padding: 10;">
            <Label text="© 2025 Shohoj Jibon - Developed by Three_Legend" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>

