<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.threelegend.shohojjibon.controller.AdminDashboardController"
            style="-fx-background-color: #f5f7fa;">
    
    <!-- Top Bar -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #ef4444, #dc2626); -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Shohoj Jibon - Admin Dashboard" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                <Button text="Logout" fx:id="logoutButton" onAction="#handleLogout" 
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Main Content -->
    <center>
        <VBox spacing="30" alignment="CENTER" style="-fx-padding: 50;">
            <!-- Welcome Card -->
            <VBox spacing="15" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 3); -fx-max-width: 600;">
                <Label text="👨‍💼" style="-fx-font-size: 48px;"/>
                <Label fx:id="welcomeLabel" text="Welcome, Admin!" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
                <Label text="System Administrator" style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
                
                <Separator prefWidth="300">
                    <VBox.margin>
                        <Insets top="10" bottom="10"/>
                    </VBox.margin>
                </Separator>
                
                <VBox spacing="10" alignment="CENTER">
                    <Label text="Admin Control Panel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Label text="Manage system, users, and providers" style="-fx-font-size: 14px; -fx-text-fill: #888;"/>
                </VBox>
            </VBox>
            
            <!-- Feature Cards -->
            <HBox spacing="20" alignment="CENTER">
                <VBox spacing="10" alignment="CENTER" style="-fx-background-color: #fef2f2; -fx-padding: 30; -fx-background-radius: 10; -fx-pref-width: 200;">
                    <Label text="👥" style="-fx-font-size: 32px;"/>
                    <Label text="User Management" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #991b1b;"/>
                    <Label text="Coming Soon" style="-fx-font-size: 12px; -fx-text-fill: #dc2626;"/>
                </VBox>
                
                <VBox spacing="10" alignment="CENTER" style="-fx-background-color: #eff6ff; -fx-padding: 30; -fx-background-radius: 10; -fx-pref-width: 200;">
                    <Label text="📊" style="-fx-font-size: 32px;"/>
                    <Label text="Analytics" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <Label text="Coming Soon" style="-fx-font-size: 12px; -fx-text-fill: #3b82f6;"/>
                </VBox>
                
                <VBox spacing="10" alignment="CENTER" style="-fx-background-color: #f0fdf4; -fx-padding: 30; -fx-background-radius: 10; -fx-pref-width: 200;">
                    <Label text="⚙️" style="-fx-font-size: 32px;"/>
                    <Label text="System Settings" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
                    <Label text="Coming Soon" style="-fx-font-size: 12px; -fx-text-fill: #16a34a;"/>
                </VBox>
            </HBox>
            
            <!-- Info Box -->
            <VBox spacing="10" alignment="CENTER" style="-fx-background-color: #fef3c7; -fx-padding: 20; -fx-background-radius: 8; -fx-max-width: 600;">
                <Label text="🔐 Admin Panel Under Development" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #92400e;"/>
                <Label text="Full admin features including user management, analytics, system settings," style="-fx-font-size: 13px; -fx-text-fill: #b45309;" wrapText="true" textAlignment="CENTER"/>
                <Label text="and reports will be available in the next update." style="-fx-font-size: 13px; -fx-text-fill: #b45309;" wrapText="true" textAlignment="CENTER"/>
            </VBox>
        </VBox>
    </center>
    
    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #ef4444; -fx-padding: 10;">
            <Label text="© 2025 Shohoj Jibon - Developed by Three_Legend" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>

