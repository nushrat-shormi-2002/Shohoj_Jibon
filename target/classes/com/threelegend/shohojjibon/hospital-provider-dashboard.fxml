<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.threelegend.shohojjibon.controller.HospitalProviderController"
            style="-fx-background-color: #f5f7fa;">
    
    <!-- Top Bar -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #10b981, #059669); -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Shohoj Jibon - Hospital Dashboard" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label fx:id="welcomeLabel" text="Welcome!" style="-fx-text-fill: white; -fx-font-size: 16px;" HBox.hgrow="ALWAYS"/>
                <Button text="Logout" onAction="#handleLogout" 
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Main Content with Tabs -->
    <center>
        <TabPane style="-fx-padding: 20;" tabClosingPolicy="UNAVAILABLE">
            
            <!-- Overview Tab -->
            <Tab text="📊 Overview">
                <VBox spacing="20" style="-fx-padding: 20;">
                    <!-- Stats Cards -->
                    <HBox spacing="20">
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                            <Label text="👨‍⚕️ Total Doctors" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                            <Label fx:id="totalDoctorsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                        </VBox>
                        
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                            <Label text="🔬 Total Tests" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                            <Label fx:id="totalTestsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                        </VBox>
                        
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
                            <Label text="💰 Total Revenue" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                            <Label fx:id="totalRevenueLabel" text="৳0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                        </VBox>
                    </HBox>
                    
                    <!-- Hospital Info -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="Hospital Information" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        <Label fx:id="hospitalInfoLabel" text="Loading..." style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                    </VBox>
                    
                    <!-- Quick Actions -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="Quick Actions" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        <HBox spacing="15">
                            <Button text="➕ Add Doctor" onAction="#handleAddDoctor" 
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            <Button text="➕ Add Test" onAction="#handleAddTest" 
                                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            <Button text="🔄 Refresh Data" onAction="#handleRefreshData" 
                                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </Tab>
            
            <!-- Manage Doctors Tab -->
            <Tab text="👨‍⚕️ Manage Doctors">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Your Doctors" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;" HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Add Doctor" onAction="#handleAddDoctor" 
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                        <Button text="🔄 Refresh" onAction="#handleRefreshDoctors" 
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                    </HBox>
                    
                    <TableView fx:id="doctorTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 6;">
                        <columns>
                            <TableColumn fx:id="doctorNameCol" text="Doctor Name" prefWidth="180"/>
                            <TableColumn fx:id="specialtyCol" text="Specialty" prefWidth="150"/>
                            <TableColumn fx:id="qualificationsCol" text="Qualifications" prefWidth="150"/>
                            <TableColumn fx:id="experienceCol" text="Experience" prefWidth="100"/>
                            <TableColumn fx:id="feeCol" text="Fee" prefWidth="100"/>
                            <TableColumn fx:id="availabilityCol" text="Availability" prefWidth="150"/>
                            <TableColumn fx:id="doctorStatusCol" text="Status" prefWidth="80"/>
                            <TableColumn fx:id="doctorActionsCol" text="Actions" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- Manage Tests Tab -->
            <Tab text="🔬 Manage Tests">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Diagnostic Tests" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;" HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Add Test" onAction="#handleAddTest" 
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                        <Button text="🔄 Refresh" onAction="#handleRefreshTests" 
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                    </HBox>
                    
                    <TableView fx:id="testTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 6;">
                        <columns>
                            <TableColumn fx:id="testNameCol" text="Test Name" prefWidth="200"/>
                            <TableColumn fx:id="categoryCol" text="Category" prefWidth="150"/>
                            <TableColumn fx:id="priceCol" text="Price" prefWidth="100"/>
                            <TableColumn fx:id="resultTimeCol" text="Result Time" prefWidth="120"/>
                            <TableColumn fx:id="homeCollectionCol" text="Home Collection" prefWidth="120"/>
                            <TableColumn fx:id="testStatusCol" text="Status" prefWidth="80"/>
                            <TableColumn fx:id="testActionsCol" text="Actions" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- Manage Bookings Tab -->
            <Tab text="📅 Manage Bookings">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Doctor Appointment Bookings" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                        <Button text="🔄 Refresh" onAction="#handleRefreshBookings" 
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                    </HBox>
                    
                    <!-- Booking Statistics -->
                    <HBox spacing="20">
                        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                            <Label text="📅 Total Bookings" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                            <Label fx:id="totalBookingsLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                        </VBox>
                        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                            <Label text="⏳ Pending" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                            <Label fx:id="pendingBookingsLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                        </VBox>
                        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                            <Label text="✅ Confirmed" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                            <Label fx:id="confirmedBookingsLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                        </VBox>
                        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" HBox.hgrow="ALWAYS">
                            <Label text="💰 Revenue" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                            <Label fx:id="bookingRevenueLabel" text="৳0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                        </VBox>
                    </HBox>
                    
                    <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 6;">
                        <columns>
                            <TableColumn fx:id="bookingIdCol" text="Booking ID" prefWidth="100"/>
                            <TableColumn fx:id="patientNameCol" text="Patient Name" prefWidth="150"/>
                            <TableColumn fx:id="bookingDoctorNameCol" text="Doctor" prefWidth="150"/>
                            <TableColumn fx:id="appointmentDateCol" text="Appointment Date" prefWidth="120"/>
                            <TableColumn fx:id="appointmentTimeCol" text="Time" prefWidth="100"/>
                            <TableColumn fx:id="symptomsCol" text="Symptoms" prefWidth="200"/>
                            <TableColumn fx:id="bookingStatusCol" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="totalAmountCol" text="Amount" prefWidth="100"/>
                            <TableColumn fx:id="bookingActionsCol" text="Actions" prefWidth="200"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
    
    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #10b981; -fx-padding: 10;">
            <Label text="© 2025 Shohoj Jibon - Developed by Three_Legend" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>

